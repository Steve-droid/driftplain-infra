# Terraform
.terraform/
*.tfstate
*.tfstate.*
crash.log
*.tfvars
!example.tfvars
# Committed NON-SECRET stack values, passed via -var-file (Roey: defaultless variables.tf + explicit
# tfvars). Secrets never live in tfvars — they come from Secrets Manager via ESO/IRSA.
!bootstrap/dev.tfvars
!platform/dev.tfvars
!jenkins/dev.tfvars
!dns/dev.tfvars
!cloudflare/dev.tfvars
!home-server/identity/dev.tfvars
# .terraform.lock.hcl IS committed (pins provider versions/hashes for reproducible init in CI).

# Env / secrets
.env
.env.*

# OS / editor
.DS_Store
.idea/
.vscode/
*.bkp

# Saved plans are local review artifacts, never source.
*.tfplan
